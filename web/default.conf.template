# Instana tracing
opentracing_load_tracer /usr/local/lib/libinstana_sensor.so /etc/instana-config.json;
opentracing_propagate_context;

server {
    listen       8080;
    server_name  localhost;

    proxy_http_version 1.1;

    # Resolve upstream names at request time rather than at config load.
    #
    # Without this, nginx resolves ${CATALOGUE_HOST} and friends while it is
    # parsing this file. If DNS is briefly unavailable -- both CoreDNS
    # replicas Terminating during a node replacement, for instance -- nginx
    # does not start at all:
    #
    #   nginx: [emerg] host not found in upstream "catalogue"
    #
    # and the container exits. Because the failure is at startup, the pod
    # crashloops and never recovers on its own, even once DNS is healthy
    # again. A variable in proxy_pass forces runtime resolution instead, and
    # the resolver directive is what makes that legal.
    #
    # 127.0.0.11 is Docker's embedded DNS, which is what a pod uses to
    # resolve sibling Service names. valid=10s bounds how long a resolved
    # address is cached, so a Service endpoint change is picked up quickly
    # instead of waiting for TTL. ipv6=off because there are no AAAA records
    # here and a stray lookup stalls the request.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 3s;

    set $catalogue_upstream "${CATALOGUE_HOST}";
    set $user_upstream      "${USER_HOST}";
    set $cart_upstream      "${CART_HOST}";
    set $shipping_upstream  "${SHIPPING_HOST}";
    set $payment_upstream   "${PAYMENT_HOST}";
    set $ratings_upstream   "${RATINGS_HOST}";

    #charset koi8-r;
    #access_log  /var/log/nginx/host.access.log  main;
    #error_log /dev/stdout debug;
    #rewrite_log on;

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        ssi    on;
    }

    location /images/ {
        expires 5s;
        root   /usr/share/nginx/html;
        try_files $uri /images/placeholder.png;
    }

    #error_page  404              /404.html;

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }

    # proxy the PHP scripts to Apache listening on 127.0.0.1:80
    #
    #location ~ \.php$ {
    #    proxy_pass   http://127.0.0.1;
    #}

    # pass the PHP scripts to FastCGI server listening on 127.0.0.1:9000
    #
    #location ~ \.php$ {
    #    root           html;
    #    fastcgi_pass   127.0.0.1:9000;
    #    fastcgi_index  index.php;
    #    fastcgi_param  SCRIPT_FILENAME  /scripts$fastcgi_script_name;
    #    include        fastcgi_params;
    #}

    # deny access to .htaccess files, if Apache's document root
    # concurs with nginx's one
    #
    #location ~ /\.ht {
    #    deny  all;
    #}

    location /api/catalogue/ {
        proxy_pass http://$catalogue_upstream:8080/;
    }

    location /api/user/ {
        proxy_pass http://$user_upstream:8080/;
    }

    location /api/cart/ {
        proxy_pass http://$cart_upstream:8080/;
    }

    location /api/shipping/ {
        proxy_pass http://$shipping_upstream:8080/;
    }

    location /api/payment/ {
        proxy_pass http://$payment_upstream:8080/;
    }

    location /api/ratings/ {
        proxy_pass http://$ratings_upstream:80/;
    }

    location /nginx_status {
        stub_status on;
        access_log off;
    }
}
